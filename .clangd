# clangd config for ESP-IDF example firmware.
# Requires: cd examples && idf.py build
#
# After build, scripts/patch_compile_commands_for_clangd.py (CMake POST_BUILD) injects
# the xtensa newlib -isystem paths so clangd can find <sys/reent.h> without
# --query-driver (which breaks on unsupported --target=xtensa).
#
# Also injects -D__XTENSA__ so IDF headers do not take the host fallback
# `#include "../hal.h"`.
CompileFlags:
  CompilationDatabase: examples/build
  Add:
    - -D__XTENSA__
    - -D__xtensa__
    - -fno-blocks
  Remove:
    - -mlongcalls
    - -fno-shrink-wrap
    - -fstrict-volatile-bitfields
    - -fno-tree-switch-conversion
    - -fzero-call-used-regs=*
    - -free*
    - -m*
    - --target=*
Index:
  Background: Build
Diagnostics:
  Suppress:
    - drv_unknown_argument
