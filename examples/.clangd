CompileFlags:
  CompilationDatabase: build
  Add:
    - -D__XTENSA__
    - -D__xtensa__
    - -fno-blocks
  Remove:
    - -mlongcalls
    - -fno-shrink-wrap
    - -fstrict-volatile-bitfields
    - -fno-tree-switch-conversion
    - -fzero-call-used-regs=*
    - -m*
    - --target=*
Diagnostics:
  Suppress:
    - drv_unknown_argument
